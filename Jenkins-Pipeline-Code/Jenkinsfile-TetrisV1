pipeline {
    agent any
    
    tools {
        nodejs 'nodejs'
    }
    
    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                // Windows va Linux o'rtasidagi LF/CRLF ogohlantirishlarini butunlay o'chiramiz
                bat 'git config --global core.autocrlf false'
                git branch: 'main', url: 'https://github.com/ersuncoder/SecureCloud-K8s-DevSecOps.git'
            }
        }
        
        stage('Installing Dependencies') {
            steps {
                dir('Tetris-V1') {
                    bat 'npm install'
                }
            }
        }
        
        stage('Trivy File Scan') {
            steps {
                dir('Tetris-V1') {
                    bat 'trivy fs . > trivyfs.txt'
                }
            }
        }

        // 🔥 SONARQUBE BOSQICHI SHU YERGA QO'SHILDI:
        stage('SonarQube Code Analysis') {
    steps {
        dir('Tetris-V1') {
            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                bat """
                    "C:\\ProgramData\\Jenkins\\.jenkins\\tools\\hudson.plugins.sonar.SonarRunnerInstallation\\sonar-scanner\\bin\\sonar-scanner.bat" ^
                    -Dsonar.token=%SONAR_TOKEN%
                """
            }
        }
    }
}
        
        stage("Docker Image Build") {
            steps {
                script {
                    dir('Tetris-V1') {
                        withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                            bat 'docker system prune -f'
                            bat 'docker build -t tetrisv1 .'
                        }
                    }
                }
            }
        }
        
        stage("Docker Image Pushing") {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        bat "docker tag tetrisv1 ersun7/tetrisv1:${BUILD_NUMBER}"
                        bat "docker push ersun7/tetrisv1:${BUILD_NUMBER}"
                    }
                }
            }
        }
        
        stage("TRIVY Image Scan") {
            steps {
                bat "trivy image ersun7/tetrisv1:${BUILD_NUMBER} > trivyimage.txt"
            }
        }

        stage('Update Deployment file') {
            environment {
                GIT_REPO_NAME = "SecureCloud-K8s-DevSecOps"
                GIT_USER_NAME = "ersuncoder"
            }
            steps {
                dir('Manifest-file') {
                    withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                        bat """
                            @echo off
                            :: 1. Avtomatlashtirish: deployment-service.yml faylini yangilash
                            powershell -Command "(Get-Content deployment-service.yml) -replace 'tetrisv1:[0-9]+', 'tetrisv1:${BUILD_NUMBER}' | Set-Content deployment-service.yml"

                            :: 2. Git sozlamalari
                            git config user.email "ermatovs426@gmail.com"
                            git config user.name "ersuncoder"
                            
                            :: 3. Git-ga node_modules va keraksiz txt fayllarni vaqtincha e'tiborsiz qoldirishni aytamiz
                            :: Bu buyruq 1 soatlab tekshirish va qulflangan fayllar xatoligini oldini oladi
                            git config core.excludesfile .gitignore
                            
                            :: 4. Faqatgina biz o'zgartirgan deployment faylini indekslaymiz
                            git add deployment-service.yml
                            git commit -m "Update deployment Image to version ${BUILD_NUMBER}"
                            
                            :: 5. Toza va xavfsiz pull (rebase-siz va stash-siz)
                            git pull https://%GITHUB_TOKEN%@github.com/%GIT_USER_NAME%/%GIT_REPO_NAME%.git main --no-rebase
                            
                            :: 6. GitHub-ga push
                            git push https://%GITHUB_TOKEN%@github.com/%GIT_USER_NAME%/%GIT_REPO_NAME%.git main
                        """
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline jarayoni yakunlandi.'
        }
        success {
            echo 'Muvaffaqiyatli yakunlandi!'
        }
        failure {
            echo 'Xatolik yuz berdi. Iltimos, loglarni tekshiring.'
        }
    }
}
